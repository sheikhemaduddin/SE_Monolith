{
  "name": "cloudways-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "build:ui": "npm run build --workspace=packages/ui",
    "build:mw": "npm run build --workspace=packages/mw",
    "start:mw": "npm run start --workspace=packages/mw",
    "build:api": "npm run build --workspace=packages/mw",
    "start:api": "npm run start --workspace=packages/mw",
    "dev:ui": "npm run dev --workspace=packages/ui",
    "dev:web": "npm run dev --workspace=packages/ui"
  },
  "engines": { "node": ">=18.0.0" }
}
